<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bglx_rover">

  <!-- Drive base -->
  <xacro:property name="base_x"      value="0.50"/>
  <xacro:property name="base_y"      value="0.42"/>
  <xacro:property name="base_z"      value="0.16"/>
  <xacro:property name="base_mass"   value="10.0"/>
  <xacro:property name="base_h"      value="0.13"/>

  <!-- Wheels -->
  <xacro:property name="wheel_radius" value="0.09"/>
  <xacro:property name="wheel_width"  value="0.045"/>
  <xacro:property name="wheel_sep"    value="0.45"/>
  <xacro:property name="wheel_mass"   value="0.6"/>

  <!-- Cargo column -->
  <xacro:property name="col_x"    value="0.34"/>
  <xacro:property name="col_y"    value="0.34"/>
  <xacro:property name="col_z"    value="0.80"/>
  <xacro:property name="col_mass" value="6.0"/>
  <xacro:property name="col_off"  value="-0.04"/>

  <xacro:property name="caster_r" value="0.03"/>

  <xacro:include filename="$(find bglx_rover_description)/urdf/macros/inertia_macros.xacro"/>
  <xacro:include filename="$(find bglx_rover_description)/urdf/control/rover_ros2_control.xacro"/>
  <xacro:include filename="$(find bglx_rover_description)/urdf/gazebo/gazebo_config.xacro"/>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_h}"/>
  </joint>

  <link name="base_link">
    <visual><geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry></visual>
    <collision><geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry></collision>
    <xacro:box_inertia m="${base_mass}" x="${base_x}" y="${base_y}" z="${base_z}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>

  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </xacro:cylinder_inertia>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="0 ${reflect*wheel_sep/2} ${wheel_radius - base_h}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <xacro:macro name="caster" params="prefix x">
    <link name="caster_${prefix}">
      <visual><geometry><sphere radius="${caster_r}"/></geometry></visual>
      <collision><geometry><sphere radius="${caster_r}"/></geometry></collision>
      <xacro:sphere_inertia m="0.1" r="${caster_r}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:sphere_inertia>
    </link>
    <joint name="caster_${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="caster_${prefix}"/>
      <origin xyz="${x} 0 ${caster_r - base_h}"/>
    </joint>
  </xacro:macro>
  <xacro:caster prefix="front" x="0.19"/>
  <xacro:caster prefix="rear"  x="-0.19"/>

  <!-- Cargo column -->
  <link name="cargo_column">
    <visual><geometry><box size="${col_x} ${col_y} ${col_z}"/></geometry></visual>
    <collision><geometry><box size="${col_x} ${col_y} ${col_z}"/></geometry></collision>
    <xacro:box_inertia m="${col_mass}" x="${col_x}" y="${col_y}" z="${col_z}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>
  <joint name="cargo_column_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="cargo_column"/>
    <origin xyz="${col_off} 0 ${base_z/2 + col_z/2}"/>
  </joint>

  <!-- Cargo door (visual accent) -->
  <link name="cargo_door">
    <visual><geometry><box size="0.02 0.28 0.60"/></geometry></visual>
    <xacro:box_inertia m="0.2" x="0.02" y="0.28" z="0.60">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>
  <joint name="cargo_door_joint" type="fixed">
    <parent link="cargo_column"/>
    <child  link="cargo_door"/>
    <origin xyz="${col_x/2 + 0.011} 0 -0.03"/>
  </joint>

  <!-- Head -->
  <link name="head">
    <visual><geometry><box size="0.32 0.32 0.09"/></geometry></visual>
    <collision><geometry><box size="0.32 0.32 0.09"/></geometry></collision>
    <xacro:box_inertia m="1.0" x="0.32" y="0.32" z="0.09">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>
  <joint name="head_joint" type="fixed">
    <parent link="cargo_column"/>
    <child  link="head"/>
    <origin xyz="0 0 ${col_z/2 + 0.045}"/>
  </joint>

  <!-- Forward nav lidar, mounted ahead of the column -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.045" length="0.06"/></geometry></visual>
    <collision><geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
    <xacro:cylinder_inertia m="0.2" r="0.045" h="0.06">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0.20 0 ${base_z/2 + 0.03}"/>
  </joint>

  <link name="imu_link">
    <visual><geometry><box size="0.03 0.03 0.03"/></geometry></visual>
    <xacro:box_inertia m="0.05" x="0.03" y="0.03" z="0.03">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.04"/>
  </joint>

</robot>
