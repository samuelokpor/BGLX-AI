<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="campus_world">
    
    <!-- Physics settings for stability -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ============================================================ -->
    <!-- PHASE 2 NEGATIVE-TERRAIN TEST GROUND                        -->
    <!--                                                              -->
    <!-- Normal road surface: z = 0                                   -->
    <!-- Trench begins:       x = 2.20 m                              -->
    <!-- Trench ends:         x = 3.00 m                              -->
    <!-- Lower floor:         z = -0.20 m                             -->
    <!--                                                              -->
    <!-- Robot remains on the near deck. This world is for stationary -->
    <!-- depth-sensor drop-off / pothole testing only.                 -->
    <!-- ============================================================ -->
    <model name="ground_plane">
      <static>true</static>

      <!-- Near road: x = -50.0 .. +2.20 -->
      <link name="near_deck">
        <pose>-23.90 0 -0.05 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>52.20 100.0 0.10</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>52.20 100.0 0.10</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>


      <!-- Far road: x = +3.00 .. +50.0 -->
      <link name="far_deck">
        <pose>26.50 0 -0.05 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>47.00 100.0 0.10</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>47.00 100.0 0.10</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>


      <!--
        Actual lower surface of the trench.

        x = 2.20 .. 3.00
        top surface = -0.20 m

        Thickness 0.10 m, therefore link center z = -0.25 m.
      -->
      <link name="lower_floor">
        <pose>2.60 0 -0.25 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.80 100.0 0.10</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.80 100.0 0.10</size>
            </box>
          </geometry>

          <material>
            <ambient>0.18 0.18 0.18 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>

    </model>

    <!-- ============================================================== -->
    <!-- CAMPUS BUILDINGS                                               -->
    <!-- ============================================================== -->

    <!-- Main Building -->
    <model name="building_main">
      <static>true</static>
      <pose>15 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10 20 5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10 20 5</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.8 0.8 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Library Building -->
    <model name="building_library">
      <static>true</static>
      <pose>-12 15 1.5 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8 12 3</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8 12 3</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.4 0.35 1</ambient>
            <diffuse>0.7 0.6 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cafeteria -->
    <model name="building_cafeteria">
      <static>true</static>
      <pose>-10 -12 1.25 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6 8 2.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 8 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.5 0.4 1</ambient>
            <diffuse>0.8 0.7 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- PATHWAYS (slightly raised concrete paths)                      -->
    <!-- ============================================================== -->

    <!-- pathway_main intentionally omitted for negative-terrain test -->

    <!-- Side pathway to library -->
    <model name="pathway_library">
      <static>true</static>
      <pose>-5 8 0.02 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>12 1.5 0.04</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>12 1.5 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- OBSTACLES - Benches, Trash cans, Bike racks                    -->
    <!-- ============================================================== -->

    <!-- Bench 1 -->
    <model name="bench_1">
      <static>true</static>
      <pose>3 3 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.25 0.1 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bench 2 -->
    <model name="bench_2">
      <static>true</static>
      <pose>3 -3 0.25 0 0 -0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.25 0.1 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trash can 1 -->
    <model name="trashcan_1">
      <static>true</static>
      <pose>6 2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.25</radius><length>0.8</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.25</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.2 1</ambient>
            <diffuse>0.3 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trash can 2 -->
    <model name="trashcan_2">
      <static>true</static>
      <pose>-3 5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.25</radius><length>0.8</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.25</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.2 1</ambient>
            <diffuse>0.3 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bike rack -->
    <model name="bike_rack">
      <static>true</static>
      <pose>8 -5 0.4 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>2 0.3 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>2 0.3 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- TREES (cylinders for trunks, spheres for canopy)               -->
    <!-- ============================================================== -->

    <!-- Tree 1 -->
    <model name="tree_1">
      <static>true</static>
      <pose>-2 -6 0 0 0 0</pose>
      <link name="trunk">
        <visual name="trunk_visual">
          <pose>0 0 1 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.15</radius><length>2</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 1 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.15</radius><length>2</length></cylinder>
          </geometry>
        </collision>
        <visual name="canopy_visual">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry>
            <sphere><radius>1.2</radius></sphere>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.1 1</ambient>
            <diffuse>0.2 0.6 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="canopy_collision">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry>
            <sphere><radius>1.2</radius></sphere>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Tree 2 -->
    <model name="tree_2">
      <static>true</static>
      <pose>5 8 0 0 0 0</pose>
      <link name="trunk">
        <visual name="trunk_visual">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.2</radius><length>2.4</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.2</radius><length>2.4</length></cylinder>
          </geometry>
        </collision>
        <visual name="canopy_visual">
          <pose>0 0 3 0 0 0</pose>
          <geometry>
            <sphere><radius>1.5</radius></sphere>
          </geometry>
          <material>
            <ambient>0.1 0.35 0.1 1</ambient>
            <diffuse>0.2 0.55 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tree 3 -->
    <model name="tree_3">
      <static>true</static>
      <pose>-8 -2 0 0 0 0</pose>
      <link name="trunk">
        <visual name="trunk_visual">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.12</radius><length>1.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.22 0.12 1</ambient>
            <diffuse>0.55 0.38 0.22 1</diffuse>
          </material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.12</radius><length>1.8</length></cylinder>
          </geometry>
        </collision>
        <visual name="canopy_visual">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry>
            <sphere><radius>1.0</radius></sphere>
          </geometry>
          <material>
            <ambient>0.15 0.45 0.15 1</ambient>
            <diffuse>0.25 0.65 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- LAMP POSTS                                                     -->
    <!-- ============================================================== -->

    <!-- Lamp post 1 -->
    <model name="lamp_1">
      <static>true</static>
      <pose>1 5 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>3</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="pole_col">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>3</length></cylinder>
          </geometry>
        </collision>
        <visual name="lamp">
          <pose>0 0 3.1 0 0 0</pose>
          <geometry>
            <sphere><radius>0.15</radius></sphere>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.7 1</ambient>
            <diffuse>1 1 0.8 1</diffuse>
            <emissive>0.3 0.3 0.2 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Lamp post 2 -->
    <model name="lamp_2">
      <static>true</static>
      <pose>1 -5 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>3</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="pole_col">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.05</radius><length>3</length></cylinder>
          </geometry>
        </collision>
        <visual name="lamp">
          <pose>0 0 3.1 0 0 0</pose>
          <geometry>
            <sphere><radius>0.15</radius></sphere>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.7 1</ambient>
            <diffuse>1 1 0.8 1</diffuse>
            <emissive>0.3 0.3 0.2 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- DELIVERY WAYPOINTS (visual markers)                            -->
    <!-- ============================================================== -->

    <!-- Waypoint A - Near main building -->
    <model name="waypoint_a">
      <static>true</static>
      <pose>10 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.5</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0.6 0 1</ambient>
            <diffuse>0 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Waypoint B - Near library -->
    <model name="waypoint_b">
      <static>true</static>
      <pose>-8 10 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.5</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0 0.6 1</ambient>
            <diffuse>0 0 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Waypoint C - Near cafeteria -->
    <model name="waypoint_c">
      <static>true</static>
      <pose>-6 -8 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.5</radius><length>0.02</length></cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.6 0 1</ambient>
            <diffuse>0.8 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>