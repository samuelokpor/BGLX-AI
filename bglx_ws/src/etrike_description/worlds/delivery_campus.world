      </link>
    </model>

    <!-- ============================================================== -->
    <!-- STREET LIGHTS                                                  -->
    <!-- ============================================================== -->
    <model name="street_light_1">
      <static>true</static>
      <pose>-10 3 0 0 0 0</pose>
      <link name="light_link">
        <!-- Pole -->
        <visual name="pole">
          <pose>0 0 2 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>4</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 2 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>4</length></cylinder></geometry>
        </collision>
        <!-- Lamp -->
        <visual name="lamp">
          <pose>0 -0.3 4.2 0 0 0</pose>
          <geometry><box><size>0.15 0.6 0.1</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.7 1</ambient>
            <diffuse>0.9 0.9 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <light name="lamp_light" type="spot">
        <pose>0 -0.3 4.1 0 1.57 0</pose>
        <diffuse>1 0.95 0.8 1</diffuse>
        <specular>0.5 0.5 0.4 1</specular>
        <attenuation>
          <range>15</range>
          <constant>0.5</constant>
          <linear>0.1</linear>
          <quadratic>0.01</quadratic>
        </attenuation>
        <spot>
          <inner_angle>0.5</inner_angle>
          <outer_angle>1.0</outer_angle>
          <falloff>1.0</falloff>
        </spot>
        <cast_shadows>false</cast_shadows>
      </light>
    </model>

    <model name="street_light_2">
      <static>true</static>
      <pose>5 3 0 0 0 0</pose>
      <link name="light_link">
        <visual name="pole">
          <pose>0 0 2 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>4</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
