          <material>
            <ambient>0.1 0.38 0.14 1</ambient>
            <diffuse>0.15 0.48 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tree_5">
      <static>true</static>
      <pose>18 -8 0 0 0 2.1</pose>
      <link name="tree_link">
        <visual name="trunk">
          <pose>0 0 1.4 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>2.8</length></cylinder></geometry>
          <material>
