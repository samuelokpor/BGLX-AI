            <ambient>0.12 0.42 0.15 1</ambient>
            <diffuse>0.18 0.55 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tree_4">
      <static>true</static>
      <pose>-12 -8 0 0 0 0.5</pose>
      <link name="tree_link">
        <visual name="trunk">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>2.6</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.25 0.15 1</ambient>
            <diffuse>0.45 0.35 0.25 1</diffuse>
          </material>
        </visual>
