          <geometry><box><size>0.15 0.6 0.1</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.7 1</ambient>
            <diffuse>0.9 0.9 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="street_light_3">
      <static>true</static>
      <pose>20 3 0 0 0 0</pose>
      <link name="light_link">
        <visual name="pole">
          <pose>0 0 2 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>4</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <collision name="pole_collision">
          <pose>0 0 2 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>4</length></cylinder></geometry>
        </collision>
        <visual name="lamp">
          <pose>0 -0.3 4.2 0 0 0</pose>
          <geometry><box><size>0.15 0.6 0.1</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.7 1</ambient>
            <diffuse>0.9 0.9 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- BENCHES                                                        -->
    <!-- ============================================================== -->
    <model name="bench_1">
      <static>true</static>
      <pose>-5 4.5 0 0 0 0</pose>
      <link name="bench_link">
        <!-- Seat -->
        <visual name="seat">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.5 0.4 0.05</size></box></geometry>
          <material>
            <ambient>0.4 0.25 0.15 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="seat_collision">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.5 0.4 0.05</size></box></geometry>
        </collision>
        <!-- Back -->
        <visual name="back">
          <pose>0 0.15 0.65 0.2 0 0</pose>
          <geometry><box><size>1.5 0.05 0.35</size></box></geometry>
          <material>
            <ambient>0.4 0.25 0.15 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Legs -->
        <visual name="leg_1">
          <pose>-0.6 0 0.22 0 0 0</pose>
          <geometry><box><size>0.05 0.35 0.44</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="leg_2">
          <pose>0.6 0 0.22 0 0 0</pose>
          <geometry><box><size>0.05 0.35 0.44</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bench_2">
      <static>true</static>
      <pose>10 4.5 0 0 0 0</pose>
      <link name="bench_link">
        <visual name="seat">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.5 0.4 0.05</size></box></geometry>
          <material>
            <ambient>0.4 0.25 0.15 1</ambient>
            <diffuse>0.5 0.35 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="seat_collision">
          <pose>0 0 0.45 0 0 0</pose>
