<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="delivery_campus">
    
    <!-- ============================================================== -->
    <!-- PHYSICS SETTINGS                                               -->
    <!-- ============================================================== -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.4</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ============================================================== -->
    <!-- SCENE SETTINGS - Realistic lighting                            -->
    <!-- ============================================================== -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- Sun light - morning angle for nice shadows -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.5 0.5 0.45 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- Fill light for softer shadows -->
    <light name="fill_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.3 0.3 0.35 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 -0.3 -0.5</direction>
    </light>

    <!-- ============================================================== -->
    <!-- GROUND PLANE - Asphalt texture                                 -->
    <!-- ============================================================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- MAIN ROAD - Delivery route                                     -->
    <!-- ============================================================== -->
    <model name="main_road">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="road_link">
        <visual name="road_visual">
          <geometry>
            <box>
              <size>60 4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="road_collision">
          <geometry>
            <box>
              <size>60 4 0.02</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Road center line markings -->
    <model name="center_line_1">
      <static>true</static>
      <pose>-10 0 0.02 0 0 0</pose>
      <link name="line_link">
        <visual name="visual">
          <geometry><box><size>3 0.1 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="center_line_2">
      <static>true</static>
      <pose>-5 0 0.02 0 0 0</pose>
      <link name="line_link">
        <visual name="visual">
          <geometry><box><size>3 0.1 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="center_line_3">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="line_link">
        <visual name="visual">
          <geometry><box><size>3 0.1 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="center_line_4">
      <static>true</static>
      <pose>5 0 0.02 0 0 0</pose>
      <link name="line_link">
        <visual name="visual">
          <geometry><box><size>3 0.1 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="center_line_5">
      <static>true</static>
      <pose>10 0 0.02 0 0 0</pose>
      <link name="line_link">
        <visual name="visual">
          <geometry><box><size>3 0.1 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- SIDEWALK - Pedestrian path                                     -->
    <!-- ============================================================== -->
    <model name="sidewalk_north">
      <static>true</static>
      <pose>0 4 0.03 0 0 0</pose>
      <link name="sidewalk_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>60 2 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.55 1</ambient>
            <diffuse>0.7 0.7 0.65 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>60 2 0.06</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="sidewalk_south">
      <static>true</static>
      <pose>0 -4 0.03 0 0 0</pose>
      <link name="sidewalk_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>60 2 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.55 1</ambient>
            <diffuse>0.7 0.7 0.65 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>60 2 0.06</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- BUILDING 1 - Modern office block                               -->
    <!-- ============================================================== -->
    <model name="building_office">
      <static>true</static>
      <pose>-15 12 0 0 0 0</pose>
      <link name="building_link">
        <!-- Main structure -->
        <visual name="main_visual">
          <pose>0 0 4 0 0 0</pose>
          <geometry>
            <box>
              <size>12 8 8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.75 1</ambient>
            <diffuse>0.8 0.8 0.85 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="main_collision">
          <pose>0 0 4 0 0 0</pose>
          <geometry>
            <box>
              <size>12 8 8</size>
            </box>
          </geometry>
        </collision>
        <!-- Windows -->
        <visual name="windows_front">
          <pose>0 -4.01 4 0 0 0</pose>
          <geometry>
            <box>
              <size>10 0.02 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.4 1</ambient>
            <diffuse>0.3 0.4 0.5 1</diffuse>
            <specular>0.8 0.8 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- BUILDING 2 - Warehouse/Delivery hub                            -->
    <!-- ============================================================== -->
    <model name="building_warehouse">
      <static>true</static>
      <pose>15 12 0 0 0 0</pose>
      <link name="building_link">
        <visual name="main_visual">
          <pose>0 0 3 0 0 0</pose>
          <geometry>
            <box>
              <size>16 10 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.45 0.4 1</ambient>
            <diffuse>0.6 0.55 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="main_collision">
          <pose>0 0 3 0 0 0</pose>
          <geometry>
            <box>
              <size>16 10 6</size>
            </box>
          </geometry>
        </collision>
        <!-- Loading dock -->
        <visual name="loading_dock">
          <pose>0 -5.5 0.3 0 0 0</pose>
          <geometry>
            <box>
              <size>8 1 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="loading_dock_collision">
          <pose>0 -5.5 0.3 0 0 0</pose>
          <geometry>
            <box>
              <size>8 1 0.6</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- BUILDING 3 - Residential/Apartment                             -->
    <!-- ============================================================== -->
    <model name="building_apartment">
      <static>true</static>
      <pose>0 -12 0 0 0 0</pose>
      <link name="building_link">
        <visual name="main_visual">
          <pose>0 0 5 0 0 0</pose>
          <geometry>
            <box>
              <size>10 6 10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.55 0.45 1</ambient>
            <diffuse>0.75 0.65 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="main_collision">
          <pose>0 0 5 0 0 0</pose>
          <geometry>
            <box>
              <size>10 6 10</size>
            </box>
          </geometry>
        </collision>
        <!-- Balconies -->
        <visual name="balcony_1">
          <pose>0 -3.3 3 0 0 0</pose>
          <geometry><box><size>2 0.8 0.1</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
        <visual name="balcony_2">
          <pose>0 -3.3 6 0 0 0</pose>
          <geometry><box><size>2 0.8 0.1</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================== -->
    <!-- TREES - Realistic vegetation                                   -->
    <!-- ============================================================== -->
    <!-- Tree macro repeated for forest effect -->
    <model name="tree_1">
      <static>true</static>
      <pose>-8 7 0 0 0 0.3</pose>
      <link name="tree_link">
        <!-- Trunk -->
        <visual name="trunk">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>2.4</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.25 0.15 1</ambient>
            <diffuse>0.45 0.35 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>2.4</length></cylinder></geometry>
        </collision>
        <!-- Canopy -->
        <visual name="canopy">
          <pose>0 0 3.5 0 0 0</pose>
          <geometry><sphere><radius>1.8</radius></sphere></geometry>
          <material>
            <ambient>0.1 0.4 0.15 1</ambient>
            <diffuse>0.15 0.5 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="canopy_collision">
          <pose>0 0 3.5 0 0 0</pose>
          <geometry><sphere><radius>1.8</radius></sphere></geometry>
        </collision>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static>
      <pose>-20 8 0 0 0 0.7</pose>
      <link name="tree_link">
        <visual name="trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>3</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.25 0.15 1</ambient>
            <diffuse>0.45 0.35 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>3</length></cylinder></geometry>
        </collision>
        <visual name="canopy">
          <pose>0 0 4 0 0 0</pose>
          <geometry><sphere><radius>2.2</radius></sphere></geometry>
          <material>
            <ambient>0.08 0.35 0.12 1</ambient>
            <diffuse>0.12 0.45 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tree_3">
      <static>true</static>
      <pose>8 7 0 0 0 1.2</pose>
