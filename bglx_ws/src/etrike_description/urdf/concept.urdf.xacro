      <material name="bglx_sensor">
        <color rgba="0.12 0.14 0.13 1.0" />
      </material>
    </visual>
  </link>
  <joint name="left_depth_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="left_depth_link" />
    <origin xyz="0.45 0.48 0.45" rpy="0 0.26 1.570796327" />
  </joint>
  <link name="right_depth_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05" />
    </inertial>
    <collision name="right_depth_link_housing">
      <origin xyz="-0.018 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.04 0.035" />
      </geometry>
    </collision>
    <visual name="right_depth_link_housing">
      <origin xyz="-0.018 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.04 0.035" />
      </geometry>
      <material name="bglx_sensor">
        <color rgba="0.12 0.14 0.13 1.0" />
      </material>
    </visual>
  </link>
  <joint name="right_depth_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="right_depth_link" />
    <origin xyz="0.45 -0.48 0.45" rpy="0 0.26 -1.570796327" />
  </joint>
  <link name="rear_depth_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05" />
    </inertial>
    <collision name="rear_depth_link_housing">
      <origin xyz="-0.018 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.04 0.035" />
      </geometry>
    </collision>
    <visual name="rear_depth_link_housing">
      <origin xyz="-0.018 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.04 0.035" />
      </geometry>
      <material name="bglx_sensor">
        <color rgba="0.12 0.14 0.13 1.0" />
      </material>
    </visual>
  </link>
  <joint name="rear_depth_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="rear_depth_link" />
    <origin xyz="-0.34 0 0.45" rpy="0 0.26 3.141592654" />
  </joint>
  <link name="depth_camera_optical" />
  <joint name="depth_camera_optical_joint" type="fixed">
    <parent link="depth_camera" />
    <child link="depth_camera_optical" />
    <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327" />
  </joint>
  <link name="camera_front_main_optical" />
  <joint name="camera_front_main_optical_joint" type="fixed">
    <parent link="camera_front_main" />
    <child link="camera_front_main_optical" />
    <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327" />
  </joint>
  <gazebo reference="lidar_sensor">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.45</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="scan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_sensor</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="camera_front_main">
    <sensor name="camera_front" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <camera name="front">
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>800</width>
          <height>600</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <plugin name="camera_front_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>image_raw:=/etrike/front/image_raw</remapping>
          <remapping>camera_info:=/etrike/front/camera_info</remapping>
        </ros>
        <camera_name>front</camera_name>
        <frame_name>camera_front_main_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>base_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="depth_camera">
    <sensor name="front_depth_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>

      <camera name="front_depth_camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.15</near>
          <far>6.0</far>
        </clip>
      </camera>

      <plugin name="front_depth_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>image_raw:=front_camera/image_raw</remapping>
          <remapping>camera_info:=front_camera/camera_info</remapping>
          <remapping>depth/image_raw:=front_camera/depth/image_raw</remapping>
          <remapping>depth/camera_info:=front_camera/depth/camera_info</remapping>
        </ros>

        <camera_name>front_camera</camera_name>
        <frame_name>depth_camera_optical</frame_name>
      </plugin>
    </sensor>
    <sensor name="front_depth" type="depth">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <camera name="front_terrain">
        <horizontal_fov>1.22173</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.15</near>
          <far>4.0</far>
        </clip>
      </camera>
      <plugin name="front_terrain_depth_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>image_raw:=/etrike/front_depth/image_raw</remapping><remapping>camera_info:=/etrike/front_depth/camera_info</remapping><remapping>depth/image_raw:=/etrike/front_depth/depth/image_raw</remapping><remapping>depth/camera_info:=/etrike/front_depth/depth/camera_info</remapping><remapping>points:=/etrike/front_depth/points</remapping></ros>
        <camera_name>front_depth</camera_name>
        <frame_name>depth_camera_optical</frame_name>
        <pointCloudCutoff>0.15</pointCloudCutoff>
        <pointCloudCutoffMax>4.0</pointCloudCutoffMax>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="front_lidar_link">
    <sensor name="front_lidar" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-2.0944</min_angle>
            <max_angle>2.0944</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>5.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="front_scan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>~/out:=front_scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>front_lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="left_depth_link">
    <material>Gazebo/Black</material>
    <sensor name="left_depth" type="ray">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>15</samples>
            <resolution>1</resolution>
            <min_angle>-0.35</min_angle>
            <max_angle>0.35</max_angle>
          </horizontal>
          <vertical>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.20</min_angle>
            <max_angle>0.20</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="left_depth_controller">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>~/out:=left_depth/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>left_depth_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="right_depth_link">
    <material>Gazebo/Black</material>
    <sensor name="right_depth" type="ray">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>15</samples>
            <resolution>1</resolution>
            <min_angle>-0.35</min_angle>
            <max_angle>0.35</max_angle>
          </horizontal>
          <vertical>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.20</min_angle>
            <max_angle>0.20</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="right_depth_controller">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>~/out:=right_depth/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>right_depth_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="rear_depth_link">
    <material>Gazebo/Black</material>
    <sensor name="rear_depth" type="ray">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>15</samples>
            <resolution>1</resolution>
            <min_angle>-0.35</min_angle>
            <max_angle>0.35</max_angle>
          </horizontal>
          <vertical>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.20</min_angle>
            <max_angle>0.20</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>4.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="rear_depth_controller">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>~/out:=rear_depth/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>rear_depth_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="steering_joint">
      <command_interface name="position">
        <param name="min">-1.047</param>
        <param name="max">1.047</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-25.0</param>
        <param name="max">25.0</param>
      </command_interface>
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-25.0</param>
        <param name="max">25.0</param>
      </command_interface>
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>
    <joint name="front_wheel_joint">
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(arg controllers_file)</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>
  <gazebo reference="base_link">
    <material>Gazebo/DarkGreen</material>
  </gazebo>
  <gazebo reference="caster_mount">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="front_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="depth_camera">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="front_lidar_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="left_depth_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="right_depth_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="rear_depth_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
</robot>