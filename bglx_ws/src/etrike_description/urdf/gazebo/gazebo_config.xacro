<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- GAZEBO CONFIGURATION - Simplified sensor suite                     -->
  <!-- 4 cameras: front, left, right, ground + LiDAR                      -->
  <!-- ================================================================== -->

  <!-- ============================================================== -->
  <!-- GAZEBO MATERIALS                                               -->
  <!-- ============================================================== -->
  
  <gazebo reference="frame_main_spine"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="frame_rear_left_vertical"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="frame_rear_right_vertical"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="frame_rear_cross"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="frame_cargo_rail_left"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="frame_cargo_rail_right"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="frame_head_tube"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="steering_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="cargo_box"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="cargo_lid"><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="battery_enclosure"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="control_panel_backing"><material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="screen"><material>Gazebo/BlueGlow</material></gazebo>
  <gazebo reference="lidar_sensor"><material>Gazebo/FlatBlack</material></gazebo>

  <!-- Camera materials -->
  <gazebo reference="camera_front_main"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="camera_front_left"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="camera_front_right"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="camera_side_left"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="camera_side_right"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="camera_rear_left"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="camera_rear_right"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="camera_rear_main"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="camera_ground"><material>Gazebo/Black</material></gazebo>

  <!-- ============================================================== -->
  <!-- WHEEL FRICTION                                                 -->
  <!-- ============================================================== -->
  
  <gazebo reference="front_wheel">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="rear_left_wheel">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="rear_right_wheel">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- ============================================================== -->
  <!-- CASTER WHEEL SETTINGS - Low friction for free swivel           -->
  <!-- ============================================================== -->
  
  <gazebo reference="caster_mount">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="front_wheel">
    <material>Gazebo/FlatBlack</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>


  <!-- ============================================================== -->
  <!-- DIFFERENTIAL DRIVE PLUGIN                                      -->
  <!-- ============================================================== -->
  
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/etrike</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      
      <wheel_separation>0.55</wheel_separation>
      <wheel_diameter>0.35</wheel_diameter>
      
      <max_wheel_torque>50</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- ============================================================== -->
  <!-- LIDAR - 360° 2D Laser Scanner                                  -->
  <!-- ============================================================== -->
  
  <gazebo reference="lidar_sensor">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>15.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="scan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_sensor</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================== -->
  <!-- FRONT CAMERA - Primary forward view                            -->
  <!-- ============================================================== -->
  
  <gazebo reference="camera_front_main">
    <sensor name="camera_front" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <camera name="front">
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>800</width>
          <height>600</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <plugin name="camera_front_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>image_raw:=camera/front/image_raw</remapping>
          <remapping>camera_info:=camera/front/camera_info</remapping>
        </ros>
        <camera_name>front</camera_name>
        <frame_name>camera_front_main</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================== -->
  <!-- LEFT CAMERA - Side view for turning                            -->
  <!-- ============================================================== -->
  
  <gazebo reference="camera_side_left">
    <sensor name="camera_left" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>20</update_rate>
      <camera name="left">
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>50</far>
        </clip>
      </camera>
      <plugin name="camera_left_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>image_raw:=camera/left/image_raw</remapping>
          <remapping>camera_info:=camera/left/camera_info</remapping>
        </ros>
        <camera_name>left</camera_name>
        <frame_name>camera_side_left</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================== -->
  <!-- RIGHT CAMERA - Side view for turning                           -->
  <!-- ============================================================== -->
  
  <gazebo reference="camera_side_right">
    <sensor name="camera_right" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>20</update_rate>
      <camera name="right">
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>50</far>
        </clip>
      </camera>
      <plugin name="camera_right_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>image_raw:=camera/right/image_raw</remapping>
          <remapping>camera_info:=camera/right/camera_info</remapping>
        </ros>
        <camera_name>right</camera_name>
        <frame_name>camera_side_right</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================== -->
  <!-- GROUND CAMERA - Close obstacle detection                       -->
  <!-- ============================================================== -->
  
  <gazebo reference="camera_ground">
    <sensor name="camera_ground" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <camera name="ground">
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>5</far>
        </clip>
      </camera>
      <plugin name="camera_ground_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>image_raw:=camera/ground/image_raw</remapping>
          <remapping>camera_info:=camera/ground/camera_info</remapping>
        </ros>
        <camera_name>ground</camera_name>
        <frame_name>camera_ground</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================== -->
  <!-- IMU SENSOR                                                     -->
  <!-- ============================================================== -->
  
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/etrike</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>base_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

 

  <!-- ============================================================== -->
  <!-- JOINT STATE PUBLISHER                                          -->
  <!-- ============================================================== -->
  
  <gazebo>
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/etrike</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>caster_swivel_joint</joint_name>
      <joint_name>front_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>