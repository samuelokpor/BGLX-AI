<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia
      ixx="${(m/12.0) * (y*y + z*z)}"
      ixy="0.0"
      ixz="0.0"
      iyy="${(m/12.0) * (x*x + z*z)}"
      iyz="0.0"
      izz="${(m/12.0) * (x*x + y*y)}"
    />
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertia
      ixx="${(m/12.0) * (3*r*r + l*l)}"
      ixy="0.0"
      ixz="0.0"
      iyy="${(m/12.0) * (3*r*r + l*l)}"
      iyz="0.0"
      izz="${(m/2.0) * r*r}"
    />
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia
      ixx="${(2.0/5.0) * m * r * r}"
      ixy="0.0"
      ixz="0.0"
      iyy="${(2.0/5.0) * m * r * r}"
      iyz="0.0"
      izz="${(2.0/5.0) * m * r * r}"
    />
  </xacro:macro>

  <xacro:macro name="wheel_inertia" params="m r w">
    <inertia
      ixx="${(m/12.0) * (3*r*r + w*w)}"
      ixy="0.0"
      ixz="0.0"
      iyy="${(m/2.0) * r*r}"
      iyz="0.0"
      izz="${(m/12.0) * (3*r*r + w*w)}"
    />
  </xacro:macro>

  <xacro:macro name="dummy_inertia">
    <inertia
      ixx="0.001"
      ixy="0.0"
      ixz="0.0"
      iyy="0.001"
      iyz="0.0"
      izz="0.001"
    />
  </xacro:macro>

</robot>
