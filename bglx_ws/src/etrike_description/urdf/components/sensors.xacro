<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- SENSORS - Comprehensive autonomous vehicle sensor suite            -->
  <!-- 8 cameras + LiDAR for full 360° perception                         -->
  <!-- ================================================================== -->

  <xacro:macro name="sensors" params="parent">

    <!-- ============================================================== -->
    <!-- LIDAR - 360° scanning on top of cargo box                      -->
    <!-- ============================================================== -->
    
    <link name="lidar_base">
      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:cylinder_inertia m="0.2" r="0.04" l="0.03"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.03"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.03"/>
        </geometry>
      </collision>
    </link>

    <joint name="lidar_base_joint" type="fixed">
      <parent link="sensor_mount_plate"/>
      <child link="lidar_base"/>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
    </joint>

    <link name="lidar_sensor">
      <inertial>
        <mass value="0.8"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:cylinder_inertia m="0.8" r="0.05" l="0.07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.07"/>
        </geometry>
        <material name="lidar"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.07"/>
        </geometry>
      </collision>
    </link>

    <joint name="lidar_sensor_joint" type="fixed">
      <parent link="lidar_base"/>
      <child link="lidar_sensor"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <!-- ============================================================== -->
    <!-- FRONT MAIN CAMERA - Primary forward view (wide angle)          -->
    <!-- ============================================================== -->
    
    <link name="camera_front_main">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.1" x="0.03" y="0.08" z="0.03"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
      </collision>
    </link>

    <joint name="camera_front_main_joint" type="fixed">
      <parent link="control_panel_backing"/>
      <child link="camera_front_main"/>
      <!-- Mounted on top of control panel, facing forward -->
      <origin xyz="0.02 0 0.12" rpy="0 0 0"/>
    </joint>

    <!-- ============================================================== -->
    <!-- FRONT LEFT CAMERA - 45° angle for intersection coverage        -->
    <!-- ============================================================== -->
    
    <link name="camera_front_left">
      <inertial>
        <mass value="0.08"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.08" x="0.025" y="0.025" z="0.025"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.025"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.025"/>
        </geometry>
      </collision>
    </link>

    <joint name="camera_front_left_joint" type="fixed">
      <parent link="cargo_box"/>
      <child link="camera_front_left"/>
      <!-- Front-left corner, angled 45° outward -->
      <origin xyz="0.25 0.24 0.12" rpy="0 0 0.7"/>
    </joint>

    <!-- ============================================================== -->
    <!-- FRONT RIGHT CAMERA - 45° angle for intersection coverage       -->
    <!-- ============================================================== -->
    
    <link name="camera_front_right">
      <inertial>
        <mass value="0.08"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.08" x="0.025" y="0.025" z="0.025"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.025"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.025"/>
        </geometry>
      </collision>
    </link>

    <joint name="camera_front_right_joint" type="fixed">
      <parent link="cargo_box"/>
      <child link="camera_front_right"/>
      <!-- Front-right corner, angled 45° outward -->
      <origin xyz="0.25 -0.24 0.12" rpy="0 0 -0.7"/>
    </joint>

    <!-- ============================================================== -->
    <!-- SIDE LEFT CAMERA - 90° for lane monitoring                     -->
    <!-- ============================================================== -->
    


<!-- ============================================================== -->
    <!-- SIDE RIGHT CAMERA - 90° for lane monitoring                    -->
    <!-- ============================================================== -->
    


<!-- ============================================================== -->
    <!-- REAR LEFT CAMERA - 135° for blind spot coverage                -->
    <!-- ============================================================== -->
    
    <link name="camera_rear_left">
      <inertial>
        <mass value="0.08"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.08" x="0.025" y="0.025" z="0.025"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.025"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.025"/>
        </geometry>
      </collision>
    </link>

    <joint name="camera_rear_left_joint" type="fixed">
      <parent link="cargo_box"/>
      <child link="camera_rear_left"/>
      <!-- Rear-left corner, angled 135° -->
      <origin xyz="-0.25 0.24 0.12" rpy="0 0 2.4"/>
    </joint>

    <!-- ============================================================== -->
    <!-- REAR RIGHT CAMERA - 135° for blind spot coverage               -->
    <!-- ============================================================== -->
    
    <link name="camera_rear_right">
      <inertial>
        <mass value="0.08"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.08" x="0.025" y="0.025" z="0.025"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.025"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.025"/>
        </geometry>
      </collision>
    </link>

    <joint name="camera_rear_right_joint" type="fixed">
      <parent link="cargo_box"/>
      <child link="camera_rear_right"/>
      <!-- Rear-right corner, angled 135° -->
      <origin xyz="-0.25 -0.24 0.12" rpy="0 0 -2.4"/>
    </joint>

    <!-- ============================================================== -->
    <!-- REAR MAIN CAMERA - Backup camera                               -->
    <!-- ============================================================== -->
    
    <link name="camera_rear_main">
      <inertial>
        <mass value="0.08"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.08" x="0.025" y="0.05" z="0.025"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.05 0.025"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.05 0.025"/>
        </geometry>
      </collision>
    </link>

    <joint name="camera_rear_main_joint" type="fixed">
      <parent link="cargo_box"/>
      <child link="camera_rear_main"/>
      <!-- Center rear, pointing backward -->
      <origin xyz="-0.29 0 0.05" rpy="0 0 3.14159"/>
    </joint>

    <!-- ============================================================== -->
    <!-- GROUND CAMERA - Downward facing for close obstacle detection   -->
    <!-- ============================================================== -->
    
    <link name="camera_ground">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.05" x="0.02" y="0.02" z="0.02"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
      </collision>
    </link>

    <joint name="camera_ground_joint" type="fixed">
      <parent link="cargo_box"/>
      <child link="camera_ground"/>
      <!-- Under cargo box front, angled down 45° -->
      <origin xyz="0.20 0 -0.18" rpy="0 0.7 0"/>
    </joint>

  </xacro:macro>

</robot>