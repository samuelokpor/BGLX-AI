<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- CARGO BOX - Main storage container for deliveries                  -->
  <!-- Large dark box sitting on frame rails                              -->
  <!-- ================================================================== -->

  <xacro:property name="cargo_length" value="0.55"/>           <!-- X dimension -->
  <xacro:property name="cargo_width" value="0.45"/>            <!-- Y dimension -->
  <xacro:property name="cargo_height" value="0.35"/>           <!-- Z dimension -->
  <xacro:property name="cargo_mass" value="5.0"/>              <!-- Empty weight -->
  <xacro:property name="cargo_wall_thickness" value="0.02"/>   <!-- Wall thickness for visual detail -->

  <xacro:macro name="cargo_box" params="parent">

    <!-- ============================================================== -->
    <!-- CARGO BOX MAIN BODY                                            -->
    <!-- ============================================================== -->
    
    <link name="cargo_box">
      <inertial>
        <mass value="${cargo_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="${cargo_mass}" x="${cargo_length}" y="${cargo_width}" z="${cargo_height}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${cargo_length} ${cargo_width} ${cargo_height}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${cargo_length} ${cargo_width} ${cargo_height}"/>
        </geometry>
      </collision>
    </link>

    <joint name="cargo_box_joint" type="fixed">
      <parent link="base_link"/>
      <child link="cargo_box"/>
      <!-- Sitting on top of frame rails -->
      <origin xyz="0.45 0 ${0.35 + cargo_height/2 + 0.02}" rpy="0 0 0"/>
    </joint>

    <!-- ============================================================== -->
    <!-- CARGO LID - Top cover (fixed for now, can make hinged later)   -->
    <!-- ============================================================== -->
    
    <link name="cargo_lid">
      <inertial>
        <mass value="0.8"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.8" x="${cargo_length + 0.02}" y="${cargo_width + 0.02}" z="0.03"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${cargo_length + 0.02} ${cargo_width + 0.02} 0.03"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${cargo_length + 0.02} ${cargo_width + 0.02} 0.03"/>
        </geometry>
      </collision>
    </link>

    <joint name="cargo_lid_joint" type="fixed">
      <parent link="cargo_box"/>
      <child link="cargo_lid"/>
      <origin xyz="0 0 ${cargo_height/2 + 0.015}" rpy="0 0 0"/>
    </joint>

    <!-- ============================================================== -->
    <!-- CARGO HANDLE - Grab handle on back                             -->
    <!-- ============================================================== -->
    
    <link name="cargo_handle">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:cylinder_inertia m="0.1" r="0.01" l="0.12"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.01" length="0.12"/>
        </geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.01" length="0.12"/>
        </geometry>
      </collision>
    </link>

    <joint name="cargo_handle_joint" type="fixed">
      <parent link="cargo_box"/>
      <child link="cargo_handle"/>
      <origin xyz="${-cargo_length/2 - 0.02} 0 ${cargo_height/2 - 0.05}" rpy="0 0 0"/>
    </joint>

    <!-- ============================================================== -->
    <!-- SENSOR MOUNT PLATE - For LiDAR on top of cargo                 -->
    <!-- ============================================================== -->
    
    <link name="sensor_mount_plate">
      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.3" x="0.15" y="0.15" z="0.01"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.15 0.15 0.01"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.15 0.15 0.01"/>
        </geometry>
      </collision>
    </link>

    <joint name="sensor_mount_plate_joint" type="fixed">
      <parent link="cargo_lid"/>
      <child link="sensor_mount_plate"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </joint>

    <!-- ==== BGLX accent stripes (visual only) ==== -->
    <link name="accent_left">
      <inertial><mass value="0.01"/><origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.50 0.014 0.05"/></geometry>
        <material name="bglx_green"/></visual>
    </link>
    <joint name="accent_left_joint" type="fixed">
      <parent link="cargo_box"/><child link="accent_left"/>
      <origin xyz="0 0.229 -0.10" rpy="0 0 0"/>
    </joint>
    <gazebo reference="accent_left"><material>Gazebo/Green</material></gazebo>
    <link name="accent_right">
      <inertial><mass value="0.01"/><origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.50 0.014 0.05"/></geometry>
        <material name="bglx_green"/></visual>
    </link>
    <joint name="accent_right_joint" type="fixed">
      <parent link="cargo_box"/><child link="accent_right"/>
      <origin xyz="0 -0.229 -0.10" rpy="0 0 0"/>
    </joint>
    <gazebo reference="accent_right"><material>Gazebo/Green</material></gazebo>
    <link name="accent_front">
      <inertial><mass value="0.01"/><origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.014 0.40 0.05"/></geometry>
        <material name="bglx_green"/></visual>
    </link>
    <joint name="accent_front_joint" type="fixed">
      <parent link="cargo_box"/><child link="accent_front"/>
      <origin xyz="0.281 0 -0.10" rpy="0 0 0"/>
    </joint>
    <gazebo reference="accent_front"><material>Gazebo/Green</material></gazebo>

  </xacro:macro>

</robot>
