<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- FRONT FORK - ACTIVELY STEERED wheel (Track A tricycle migration)   -->
  <!--                                                                    -->
  <!-- Was: a free 'caster' (continuous swivel) that followed diff-drive. -->
  <!-- Now: an actively commanded steering axis (revolute steering_joint) -->
  <!-- driven by ros2_control's tricycle_steering_controller.             -->
  <!--                                                                    -->
  <!-- DEST: bglx_ws/src/etrike_description/urdf/components/front_fork.xacro -->
  <!-- ================================================================== -->

  <xacro:property name="front_wheel_radius" value="0.175"/>
  <xacro:property name="front_wheel_width" value="0.05"/>
  <xacro:property name="front_wheel_mass" value="2.0"/>

  <!-- Steering limit (rad). ~0.6 rad = ~34 deg. With wheelbase 1.33 m this
       gives minimum turning radius R = L / tan(delta) ~ 1.95 m.
       Keep in sync with nav2_params planner minimum_turning_radius (>= R)
       and cmd_vel_limiter.py max_steering_angle. -->
  <xacro:property name="max_steer" value="1.047"/>

  <xacro:macro name="front_fork" params="parent">

    <!-- STEERING YOKE (link name kept as caster_mount so gazebo material
         references in gazebo_config.xacro still resolve). -->
    <link name="caster_mount">
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.5" x="0.06" y="0.06" z="0.04"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.06 0.06 0.04"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.06 0.06 0.04"/></geometry>
      </collision>
    </link>

    <!-- STEERING JOINT: renamed from caster_swivel_joint, changed
         continuous(free) -> revolute(limited, actively driven). -->
    <joint name="steering_joint" type="revolute">
      <parent link="frame_head_tube"/>
      <child link="caster_mount"/>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="50.0" velocity="2.0" lower="${-max_steer}" upper="${max_steer}"/>
      <dynamics damping="3.0" friction="0.5"/>
    </joint>

    <!-- FORK ASSEMBLY -->
    <link name="steering_link">
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 -0.12" rpy="0 0 0"/>
        <xacro:box_inertia m="1.0" x="0.04" y="0.10" z="0.25"/>
      </inertial>
      <visual>
        <origin xyz="0.02 0 -0.04" rpy="0 0 0"/>
        <geometry><cylinder radius="0.022" length="0.12"/></geometry>
        <material name="fork"/>
      </visual>
      <visual>
        <origin xyz="0.035 0 -0.05" rpy="0 0 0"/>
        <geometry><box size="0.05 0.13 0.04"/></geometry>
        <material name="fork"/>
      </visual>
      <visual>
        <origin xyz="0.04 0.055 -0.17" rpy="0 0 0"/>
        <geometry><cylinder radius="0.016" length="0.26"/></geometry>
        <material name="fork"/>
      </visual>
      <visual>
        <origin xyz="0.04 -0.055 -0.17" rpy="0 0 0"/>
        <geometry><cylinder radius="0.016" length="0.26"/></geometry>
        <material name="fork"/>
      </visual>
      <visual>
        <origin xyz="0.04 0 -0.28" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.014" length="0.14"/></geometry>
        <material name="fork"/>
      </visual>
      <collision>
        <origin xyz="0.035 0 -0.14" rpy="0 0 0"/>
        <geometry><box size="0.05 0.14 0.26"/></geometry>
      </collision>
    </link>

    <joint name="fork_joint" type="fixed">
      <parent link="caster_mount"/>
      <child link="steering_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- FRONT WHEEL - passive rolling (front is steer-only, not driven) -->
    <link name="front_wheel">
      <inertial>
        <mass value="${front_wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:wheel_inertia m="${front_wheel_mass}" r="${front_wheel_radius}" w="${front_wheel_width}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${front_wheel_radius}" length="${front_wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${front_wheel_radius}" length="${front_wheel_width}"/></geometry>
      </collision>
    </link>

    <joint name="front_wheel_joint" type="continuous">
      <parent link="steering_link"/>
      <child link="front_wheel"/>
      <origin xyz="-0.06 0 -0.28" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.001" friction="0.001"/>
    </joint>

    <link name="front_rim">
      <inertial><mass value="0.2"/><origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
      <visual><origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.11" length="0.052"/></geometry>
        <material name="aluminum"/></visual>
    </link>
    <joint name="front_rim_joint" type="fixed">
      <parent link="front_wheel"/><child link="front_rim"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="front_rim"><material>Gazebo/Grey</material></gazebo>

    <link name="front_hubcap">
      <inertial><mass value="0.05"/><origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
      <visual><origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.045" length="0.062"/></geometry>
        <material name="hub_motor"/></visual>
    </link>
    <joint name="front_hubcap_joint" type="fixed">
      <parent link="front_wheel"/><child link="front_hubcap"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="front_hubcap"><material>Gazebo/DarkGrey</material></gazebo>

  </xacro:macro>

</robot>