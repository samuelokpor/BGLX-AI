<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- FRONT FORK - suspension-fork styling + fat tire + disc brake       -->
  <!--                                                                    -->
  <!-- VISUAL REMODEL ONLY. Joint names, link names and wheel RADIUS are  -->
  <!-- unchanged, so tricycle_steering_controller, ros2_control and the   -->
  <!-- odometry all keep working. Tire is made fatter (width only) and a  -->
  <!-- disc rotor + caliper + twin-stanchion fork are added for the look. -->
  <!-- DEST: bglx_ws/src/etrike_description/urdf/components/front_fork.xacro -->
  <!-- ================================================================== -->

  <xacro:property name="front_wheel_radius" value="0.175"/>
  <xacro:property name="front_wheel_width"  value="0.12"/>   <!-- fatter tire (was 0.05) -->
  <xacro:property name="front_wheel_mass"   value="2.0"/>

  <!-- Steering limit (rad). ~1.047 rad = 60 deg. Keep in sync with
       nav2_params minimum_turning_radius and cmd_vel_limiter. -->
  <xacro:property name="max_steer" value="1.047"/>

  <xacro:macro name="front_fork" params="parent">

    <!-- STEERING YOKE (link name caster_mount kept for joint + material refs) -->
    <link name="caster_mount">
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.5" x="0.06" y="0.06" z="0.04"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.06 0.10 0.05"/></geometry>
        <material name="fork"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.06 0.06 0.04"/></geometry>
      </collision>
    </link>

    <!-- STEERING JOINT (unchanged wiring; actively driven revolute) -->
    <joint name="steering_joint" type="revolute">
      <parent link="frame_head_tube"/>
      <child link="caster_mount"/>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="80.0" velocity="8.0" lower="${-max_steer}" upper="${max_steer}"/>
      <dynamics damping="1.0" friction="0.1"/>
    </joint>

    <!-- FORK ASSEMBLY: crown + twin upper stanchions + twin lower legs -->
    <link name="steering_link">
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 -0.15" rpy="0 0 0"/>
        <xacro:box_inertia m="1.0" x="0.06" y="0.14" z="0.28"/>
      </inertial>

      <!-- fork crown (connects legs to steerer) -->
      <visual>
        <origin xyz="0.01 0 -0.04" rpy="0 0 0"/>
        <geometry><box size="0.07 0.15 0.05"/></geometry>
        <material name="fork"/>
      </visual>
      <!-- steerer stub up into the head tube -->
      <visual>
        <origin xyz="0.0 0 0.01" rpy="0 0 0"/>
        <geometry><cylinder radius="0.024" length="0.10"/></geometry>
        <material name="fork"/>
      </visual>

      <!-- LEFT upper stanchion (silver) -->
      <visual>
        <origin xyz="0.03 0.058 -0.13" rpy="0 0 0"/>
        <geometry><cylinder radius="0.020" length="0.18"/></geometry>
        <material name="aluminum"/>
      </visual>
      <!-- RIGHT upper stanchion -->
      <visual>
        <origin xyz="0.03 -0.058 -0.13" rpy="0 0 0"/>
        <geometry><cylinder radius="0.020" length="0.18"/></geometry>
        <material name="aluminum"/>
      </visual>

      <!-- LEFT lower leg / slider (fatter, dark) -->
      <visual>
        <origin xyz="0.005 0.058 -0.24" rpy="0 0 0"/>
        <geometry><cylinder radius="0.026" length="0.12"/></geometry>
        <material name="fork"/>
      </visual>
      <!-- RIGHT lower leg / slider -->
      <visual>
        <origin xyz="0.005 -0.058 -0.24" rpy="0 0 0"/>
        <geometry><cylinder radius="0.026" length="0.12"/></geometry>
        <material name="fork"/>
      </visual>

      <!-- dropout bridge at the axle -->
      <visual>
        <origin xyz="-0.03 0 -0.29" rpy="0 0 0"/>
        <geometry><box size="0.05 0.14 0.03"/></geometry>
        <material name="fork"/>
      </visual>

      <!-- brake caliper on left lower leg near rotor top (fixed to fork) -->
      <visual>
        <origin xyz="-0.02 0.078 -0.20" rpy="0 0 0"/>
        <geometry><box size="0.03 0.022 0.06"/></geometry>
        <material name="hub_motor"/>
      </visual>

      <collision>
        <origin xyz="0.01 0 -0.15" rpy="0 0 0"/>
        <geometry><box size="0.06 0.16 0.26"/></geometry>
      </collision>
    </link>

    <joint name="fork_joint" type="fixed">
      <parent link="caster_mount"/>
      <child link="steering_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- FRONT WHEEL - passive rolling, FAT tire (radius unchanged) -->
    <link name="front_wheel">
      <inertial>
        <mass value="${front_wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:wheel_inertia m="${front_wheel_mass}" r="${front_wheel_radius}" w="${front_wheel_width}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${front_wheel_radius}" length="${front_wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${front_wheel_radius}" length="${front_wheel_width}"/></geometry>
      </collision>
    </link>

    <joint name="front_wheel_joint" type="continuous">
      <parent link="steering_link"/>
      <child link="front_wheel"/>
      <origin xyz="-0.06 0 -0.28" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.001" friction="0.001"/>
    </joint>

    <!-- RIM (widened to match fat tire) -->
    <link name="front_rim">
      <inertial><mass value="0.2"/><origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
      <visual><origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.115" length="0.055"/></geometry>
        <material name="aluminum"/></visual>
    </link>
    <joint name="front_rim_joint" type="fixed">
      <parent link="front_wheel"/><child link="front_rim"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="front_rim"><material>Gazebo/Grey</material></gazebo>

    <!-- HUB (widened) -->
    <link name="front_hubcap">
      <inertial><mass value="0.05"/><origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
      <visual><origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.045" length="0.13"/></geometry>
        <material name="hub_motor"/></visual>
    </link>
    <joint name="front_hubcap_joint" type="fixed">
      <parent link="front_wheel"/><child link="front_hubcap"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="front_hubcap"><material>Gazebo/DarkGrey</material></gazebo>

    <!-- DISC BRAKE ROTOR (rotates with wheel; brake side = +y) -->
    <link name="front_disc">
      <inertial><mass value="0.08"/><origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
      <visual><origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.090" length="0.004"/></geometry>
        <material name="aluminum"/></visual>
    </link>
    <joint name="front_disc_joint" type="fixed">
      <parent link="front_wheel"/><child link="front_disc"/>
      <origin xyz="0 0.062 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="front_disc"><material>Gazebo/Grey</material></gazebo>

    <!-- Gazebo Classic surface colours -->
    <gazebo reference="front_wheel"><material>Gazebo/FlatBlack</material></gazebo>
    <gazebo reference="steering_link"><material>Gazebo/FlatBlack</material></gazebo>

  </xacro:macro>

</robot>
