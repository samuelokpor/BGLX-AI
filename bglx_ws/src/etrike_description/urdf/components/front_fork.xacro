<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================== -->
  <!-- FRONT FORK - Caster wheel that follows the differential drive      -->
  <!-- ================================================================== -->

  <xacro:property name="front_wheel_radius" value="0.175"/>
  <xacro:property name="front_wheel_width" value="0.05"/>
  <xacro:property name="front_wheel_mass" value="2.0"/>

  <xacro:macro name="front_fork" params="parent">

    <!-- ============================================================== -->
    <!-- CASTER MOUNT - Allows 360° rotation                            -->
    <!-- ============================================================== -->
    
    <link name="caster_mount">
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:box_inertia m="0.5" x="0.06" y="0.06" z="0.04"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.06 0.04"/>
        </geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.06 0.04"/>
        </geometry>
      </collision>
    </link>

    <!-- Caster swivel joint - free rotation around Z -->
    <joint name="caster_swivel_joint" type="continuous">
      <parent link="frame_head_tube"/>
      <child link="caster_mount"/>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.01" friction="0.001"/>
    </joint>

    <!-- ============================================================== -->
    <!-- FORK ASSEMBLY                                                  -->
    <!-- ============================================================== -->
    
    <link name="steering_link">
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 -0.12" rpy="0 0 0"/>
        <xacro:box_inertia m="1.0" x="0.04" y="0.10" z="0.25"/>
      </inertial>
      
      <!-- Fork stem -->
      <visual>
        <origin xyz="0.02 0 -0.05" rpy="0 0.2 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.12"/>
        </geometry>
        <material name="fork"/>
      </visual>
      <collision>
        <origin xyz="0.02 0 -0.05" rpy="0 0.2 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.12"/>
        </geometry>
      </collision>
      
      <!-- Left fork tube -->
      <visual>
        <origin xyz="0.04 0.04 -0.18" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.20"/>
        </geometry>
        <material name="fork"/>
      </visual>
      <collision>
        <origin xyz="0.04 0.04 -0.18" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.20"/>
        </geometry>
      </collision>
      
      <!-- Right fork tube -->
      <visual>
        <origin xyz="0.04 -0.04 -0.18" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.20"/>
        </geometry>
        <material name="fork"/>
      </visual>
      <collision>
        <origin xyz="0.04 -0.04 -0.18" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.20"/>
        </geometry>
      </collision>
      
      <!-- Axle bridge -->
      <visual>
        <origin xyz="0.04 0 -0.28" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.012" length="0.08"/>
        </geometry>
        <material name="fork"/>
      </visual>
      <collision>
        <origin xyz="0.04 0 -0.28" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.012" length="0.08"/>
        </geometry>
      </collision>
    </link>

    <!-- Fork fixed to caster mount (offset creates trailing caster effect) -->
    <joint name="fork_joint" type="fixed">
      <parent link="caster_mount"/>
      <child link="steering_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ============================================================== -->
    <!-- FRONT WHEEL                                                    -->
    <!-- ============================================================== -->
    
    <link name="front_wheel">
      <inertial>
        <mass value="${front_wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:wheel_inertia m="${front_wheel_mass}" r="${front_wheel_radius}" w="${front_wheel_width}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${front_wheel_radius}" length="${front_wheel_width}"/>
        </geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${front_wheel_radius}" length="${front_wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <!-- Front wheel rotation -->
    <joint name="front_wheel_joint" type="continuous">
      <parent link="steering_link"/>
      <child link="front_wheel"/>
      <origin xyz="0.04 0 -0.28" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.001" friction="0.001"/>
    </joint>

  </xacro:macro>

</robot>