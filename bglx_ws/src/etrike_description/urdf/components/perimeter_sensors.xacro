<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Perimeter PROXIMITY sensing: left / right / rear.
       Fills the 2D LiDAR's 0.45 m minimum-range blind ring around the body,
       and catches low obstacles the main LiDAR plane misses (e.g. benches).

       CHANGED: was 3x type="depth" cameras (full depth image + pointcloud each
       frame) which saturated Gazebo Classic's single render thread at ~1.5 Hz.
       Now 3x type="ray" proximity sensors - a small vertical fan of rays, no
       image, no pointcloud - render cost is negligible so they hit full rate.
       Mirrors cheap ultrasonic/ToF proximity sensors the real trike will use.

       Each sensor publishes sensor_msgs/LaserScan on /etrike/<name>/scan,
       aimed outward (yaw) + ~15 deg down, spanning a narrow vertical wedge so
       it sees the ground-plane blind zone without the full LiDAR cost. -->
  <xacro:macro name="perimeter_prox" params="name parent x y z yaw">
    <link name="${name}_link">
      <visual><origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.025 0.025"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.025 0.025"/></geometry></collision>
      <inertial><mass value="0.05"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0.26 ${yaw}"/>
    </joint>
    <gazebo reference="${name}_link">
      <material>Gazebo/Black</material>
      <sensor name="${name}" type="ray">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>15</samples>
              <resolution>1</resolution>
              <min_angle>-0.35</min_angle>
              <max_angle>0.35</max_angle>
            </horizontal>
            <vertical>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.20</min_angle>
              <max_angle>0.20</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>4.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin filename="libgazebo_ros_ray_sensor.so" name="${name}_controller">
          <ros>
            <namespace>/etrike</namespace>
            <remapping>~/out:=${name}/scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${name}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="perimeter_sensors" params="parent">
    <!--                    name         parent      x      y      z     yaw    -->
    <xacro:perimeter_prox name="left_depth"  parent="${parent}" x="0.45"  y="0.28"  z="0.45" yaw="1.5708"/>
    <xacro:perimeter_prox name="right_depth" parent="${parent}" x="0.45"  y="-0.28" z="0.45" yaw="-1.5708"/>
    <xacro:perimeter_prox name="rear_depth"  parent="${parent}" x="-0.10" y="0.0"   z="0.45" yaw="3.14159"/>
  </xacro:macro>
</robot>
