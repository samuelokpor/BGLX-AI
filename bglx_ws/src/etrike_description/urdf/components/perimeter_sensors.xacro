<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Perimeter depth sensing: left / right / rear.
       Fills the 2D LiDAR's 0.45 m minimum-range blind ring around the body.
       Mirrors the existing front_depth plugin (libgazebo_ros_camera, /etrike ns).
       Each cam: aimed outward (yaw) + 15 deg down-pitch, 86 deg HFOV, 0.05-6 m. -->

  <xacro:macro name="perimeter_depth" params="name parent x y z yaw">
    <link name="${name}_link">
      <visual><origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.025 0.025"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.025 0.025"/></geometry></collision>
      <inertial><mass value="0.05"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0.26 ${yaw}"/>
    </joint>

    <!-- optical frame: same convention as depth_camera_optical -->
    <link name="${name}_optical"/>
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/><child link="${name}_optical"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <gazebo reference="${name}_link">
      <material>Gazebo/Black</material>
      <sensor name="${name}" type="depth">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera name="${name}">
          <horizontal_fov>1.50</horizontal_fov>
          <image><width>240</width><height>180</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>6.0</far></clip>
        </camera>
        <plugin filename="libgazebo_ros_camera.so" name="${name}_controller">
          <ros><namespace>/etrike</namespace></ros>
          <camera_name>${name}</camera_name>
          <frame_name>${name}_optical</frame_name>
          <min_depth>0.05</min_depth>
          <max_depth>6.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="perimeter_sensors" params="parent">
    <!--                     name         parent      x      y      z     yaw    -->
    <xacro:perimeter_depth name="left_depth"  parent="${parent}" x="0.45"  y="0.28"  z="0.45" yaw="1.5708"/>
    <xacro:perimeter_depth name="right_depth" parent="${parent}" x="0.45"  y="-0.28" z="0.45" yaw="-1.5708"/>
    <xacro:perimeter_depth name="rear_depth"  parent="${parent}" x="-0.10" y="0.0"   z="0.45" yaw="3.14159"/>
  </xacro:macro>
</robot>
